{
  "experiment_name": "tiger_yambda_500m_listens_sft_tuned",
  "seed": 42,
  "comet": {
    "enabled": false
  },
  "data": {
    "source": "yambda",
    "interactions_path": "data/raw/yambda/flat/500m/multi_event.parquet",
    "semantic_id_path": "datasets/semantic_ids/exp2-tuned-params/yambda_500m_listens/semantic_ids.json",
    "embeddings_path": "data/raw/yambda/embeddings.parquet"
  },
  "dataset": {
    "num_codebooks": 4,
    "dataset_type": "flat",
    "dataset_size": "500m",
    "event_file": "multi_event",
    "streaming": false,
    "hf_recent_months": 2,
    "positive_criterion": "event_type == 'listen' and played_ratio_pct >= 50",
    "allowed_event_types": null,
    "min_played_ratio_pct": null,
    "organic_filter": "any",
    "split_strategy": "leave_one_out",
    "min_history_len": 1,
    "deduplicate_consecutive": true,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "max_history_len": 50,
    "history_padding": "left",
    "train_example_layout": "prefix_target",
    "train_target_policy": "last_n",
    "train_last_n": 128,
    "train_all_prefixes": true,
    "filter_cold_items_after_split": true,
    "cold_item_train_source": "observed",
    "offset_semantic_ids_by_one": true,
    "drop_items_missing_semantic_id": true,
    "drop_items_missing_embedding": true
  },
  "dataloader": {
    "train_batch_size": 2048,
    "validation_batch_size": 1024,
    "num_workers": 6,
    "persistent_workers": true,
    "pin_memory": true,
    "train_drop_last": false
  },
  "model": {
    "embedding_dim": 128,
    "codebook_size": 256,
    "use_user_token": true,
    "user_ids_count": 1,
    "num_heads": 6,
    "num_encoder_layers": 2,
    "num_decoder_layers": 2,
    "dim_feedforward": 512,
    "d_kv": 32,
    "dropout": 0.0,
    "activation": "relu",
    "num_beams": 20,
    "top_k": 20,
    "layer_norm_eps": 0.000001,
    "initializer_range": 0.02
  },
  "method": {
    "name": "sft"
  },
  "training": {
    "max_epochs": 8,
    "max_steps": null,
    "validate_every_epochs": 1,
    "validate_every_steps": null,
    "gradient_accumulation_steps": 1,
    "max_grad_norm": 2.0,
    "use_amp": true,
    "amp_dtype": "float16",
    "log_every_steps": 200,
    "progress_bar": false,
    "run_validation_at_start": false,
    "save_best": true,
    "save_last": true,
    "save_every_epochs": null,
    "monitor": "val/sft/ndcg@10",
    "monitor_mode": "max",
    "early_stopping_patience": null,
    "early_stopping_mode": "best",
    "min_delta": 0,
    "scheduler_step_on": "none",
    "val_sample_fraction": 0.25,
    "evaluate_generation": true,
    "generation_constrain_valid_sequences": true,
    "generation_num_beams": 10,
    "generation_num_return_sequences": 10,
    "generation_topk": [1, 5, 10],
    "test_evaluate_generation": true,
    "test_generation_num_beams": 20,
    "test_generation_num_return_sequences": 20,
    "test_generation_topk": [5, 10, 20]
  },
  "optimizer": {
    "lr": 0.0018511868508356536,
    "weight_decay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 0.00000001
  },
  "scheduler": null
}
