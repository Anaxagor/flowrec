{
  "experiment_name": "tiger_instruments_sdpo",
  "seed": 42,

  "data": {
    "reviews_path": "data/raw/Musical_Instruments.json.gz",
    "metadata_path": "data/raw/meta_Musical_Instruments.jsonl.gz",
    "semantic_id_path": "datasets/semantic_ids/exp1-standard params/instruments/semantic_ids.json"
  },

  "dataset": {
    "num_codebooks": 4,
    "max_sequence_length": 20,
    "max_history_len": 20,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "item_key": "asin",
    "split_strategy": "leave_one_out",
    "train_all_prefixes": true,
    "global_history_policy": "rolling",
    "global_eval_target_mode": "last_per_user",
    "offset_semantic_ids_by_one": true,
    "filter_cold_items_after_split": false
  },

  "dataloader": {
    "train_batch_size": 256,
    "validation_batch_size": 256,
    "num_workers": 8,
    "pin_memory": true,
    "train_drop_last": true,
    "prefetch_factor": 4
  },

  "model": {
    "embedding_dim": 128,
    "codebook_size": 256,
    "num_positions": 20,
    "user_ids_count": 2000,
    "num_heads": 6,
    "num_encoder_layers": 4,
    "num_decoder_layers": 4,
    "dim_feedforward": 512,
    "d_kv": 32,
    "dropout": 0.1,
    "activation": "relu",
    "num_beams": 20,
    "top_k": 20,
    "layer_norm_eps": 1e-6,
    "initializer_range": 0.02,
    "checkpoint_path": "checkpoints/exp1-standard params/tiger/instruments/best.pt"
  },

  "method": {
    "name": "sdpo",
    "beta": 0.1,
    "num_negatives": 4,
    "negative_sampler": "random",
    "reference_model_strategy": "frozen_init",
    "loss_reduction": "mean",
    "sft_weight": 1.0
  },

  "training": {
    "max_epochs": 50,
    "validate_every_epochs": 5,
    "validate_every_steps": null,
    "gradient_accumulation_steps": 2,
    "max_grad_norm": 1.0,
    "use_amp": true,
    "amp_dtype": "bfloat16",
    "log_every_steps": 200,
    "checkpoint_dir": "checkpoints/tiger_instruments_sdpo",
    "save_best": true,
    "save_last": true,
    "monitor": "val/sft/ndcg@10",
    "monitor_mode": "max",
    "early_stopping_patience": 4,
    "min_delta": 0.001,
    "evaluate_generation": true,
    "generation_num_beams": 10,
    "generation_num_return_sequences": 10,
    "generation_topk": [5, 10],
    "test_evaluate_generation": true,
    "test_generation_num_beams": 20,
    "test_generation_num_return_sequences": 20,
    "test_generation_topk": [5, 10, 20]
  },

  "optimizer": {
    "lr": 0.0003,
    "weight_decay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 1e-8
  },

  "scheduler": null
}
