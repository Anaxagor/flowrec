{
  "experiment_name": "tiger_beauty_grpo_a2_sft_ratio_0.5",
  "experiments_dir": "experiments/tiger/beauty/grpo_reward_reserve",
  "seed": 42,
  "data": {
    "reviews_path": "data/raw/dataframe_format/reviews_beauty_2014.parquet",
    "metadata_path": "data/raw/dataframe_format/meta_beauty_2014.parquet",
    "semantic_id_path": "datasets/semantic_ids/exp2-tuned-params/beauty/semantic_ids.json"
  },
  "dataset": {
    "num_codebooks": 4,
    "max_sequence_length": 20,
    "max_history_len": 20,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "item_key": "asin",
    "metadata_item_key": "parent_asin",
    "split_strategy": "leave_one_out",
    "train_all_prefixes": true,
    "train_target_policy": "all",
    "train_example_layout": "prefix_target",
    "train_last_n": 512,
    "min_history_len": 1,
    "history_padding": "left",
    "filter_cold_items_after_split": false,
    "offset_semantic_ids_by_one": true,
    "drop_items_missing_semantic_id": true,
    "positive_criterion": "verified_purchase == True",
    "cold_item_train_source": "observed",
    "use_verified_only": false
  },
  "dataloader": {
    "train_batch_size": 256,
    "validation_batch_size": 64,
    "num_workers": 8,
    "persistent_workers": true,
    "pin_memory": true,
    "train_drop_last": false
  },
  "model": {
    "embedding_dim": 128,
    "codebook_size": 256,
    "num_positions": 20,
    "use_user_token": false,
    "user_ids_count": 0,
    "num_heads": 6,
    "num_encoder_layers": 2,
    "num_decoder_layers": 2,
    "dim_feedforward": 512,
    "d_kv": 32,
    "dropout": 0.1,
    "activation": "relu",
    "num_beams": 20,
    "top_k": 20,
    "layer_norm_eps": 1e-06,
    "initializer_range": 0.02,
    "checkpoint_path": "checkpoints/exp2-tuned_params/initial/tiger/beauty/best.pt"
  },
  "method": {
    "name": "mini-one-rec",
    "reward_model": "sasrec",
    "reward_type": "sasrec",
    "reward": {
      "transform": "softplus",
      "temperature": 1.0,
      "allow_invalid_candidates": false
    },
    "rollout_strategy": "beam",
    "num_rollouts": 16,
    "rollout_constrain_valid_sequences": true,
    "rollout_exclude_seen_items": false,
    "force_ground_truth_in_group": true,
    "clip_epsilon": 0.1,
    "beta": 0.1,
    "grpo_weight": 1.0,
    "loss_reduction": "mean",
    "normalize_advantages": true,
    "reward_power": 1.0,
    "calibrate_sft_weight": false,
    "calibration_num_batches": 8,
    "calibration_target_ratio": 0.5,
    "sasrec": {
      "checkpoint_path": "checkpoints/exp2-tuned_params/initial/sasrec/beauty/best_model.pt"
    },
    "sft_weight": 0.088236
  },
  "training": {
    "max_epochs": 12,
    "max_steps": null,
    "validate_every_epochs": 1,
    "validate_every_steps": null,
    "gradient_accumulation_steps": 8,
    "max_grad_norm": 0.5,
    "use_amp": true,
    "amp_dtype": "float16",
    "log_every_steps": 500,
    "progress_bar": false,
    "run_validation_at_start": true,
    "save_best": true,
    "save_last": true,
    "save_every_epochs": null,
    "monitor": "val/sft/ndcg@10",
    "monitor_mode": "max",
    "early_stopping_patience": 5,
    "early_stopping_mode": "best",
    "min_delta": 0.0,
    "scheduler_step_on": "none",
    "evaluate_generation": true,
    "generation_constrain_valid_sequences": true,
    "generation_num_beams": 20,
    "generation_num_return_sequences": 20,
    "generation_topk": [
      5,
      10,
      20
    ],
    "test_evaluate_generation": true,
    "test_generation_num_beams": 20,
    "test_generation_num_return_sequences": 20,
    "test_generation_topk": [
      5,
      10,
      20
    ],
    "val_sample_fraction": null,
    "val_sample_seed": 0,
    "val_sample_resample": false
  },
  "optimizer": {
    "lr": 1e-05,
    "weight_decay": 0.01,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08
  },
  "scheduler": null,
  "comet": {
    "enabled": false
  }
}
