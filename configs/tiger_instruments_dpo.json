{
  "experiment_name": "tiger_instruments_dpo",
  "seed": 42,

  "data": {
    "reviews_path": "data/raw/Musical_Instruments.json.gz",
    "metadata_path": "data/raw/meta_Musical_Instruments.jsonl.gz",
    "semantic_id_path": "datasets/semantic_ids/exp1-standard_params/instruments/semantic_ids.json"
  },

"dataset": {
  "num_codebooks": 4,
  "max_sequence_length": 20,
  "max_history_len": 20,
  "min_history_len": 1,

  "min_user_interactions": 5,
  "min_item_interactions": 5,

  "item_key": "asin",

  "positive_criterion": "verified_purchase == True",
  "filter_reviews_to_metadata": true,

  "split_strategy": "leave_one_out",
  "train_all_prefixes": true,
  "deduplicate_consecutive": false,

  "offset_semantic_ids_by_one": true,
  "filter_cold_items_after_split": false,
  "cold_item_train_source": "observed",

  "global_history_policy": "rolling",
  "global_eval_target_mode": "last_per_user"
},

  "dataloader": {
    "train_batch_size": 256,
    "validation_batch_size": 256,
    "num_workers": 8,
    "pin_memory": true,
    "train_drop_last": true,
    "prefetch_factor": 4
  },

  "model": {
    "codebook_size": 256,
    "decoder_start_token_id": 816,
    "dim_feedforward": 512,
    "dropout": 0.1,
    "embedding_dim": 128,
    "eos_token_id": 817,
    "num_beams": 20,
    "num_decoder_layers": 2,
    "num_encoder_layers": 2,
    "num_heads": 6,
    "num_return_sequences": 20,
    "pad_token_id": 818,
    "sem_id_len": 4,
    "semantic_vocab_size": 786,
    "unified_vocab_size": 819,
    "user_ids_count": 1,
    "d_kv": 32,
    "checkpoint_path": "checkpoints/exp1-standard_params/tiger/instruments/seed_42/best.pt"
  },
    
  "method": {
  "name": "dpo",
  "beta": 0.1,
  "negative_sampler": "random",
  "reference_model_strategy": "frozen_init",
  "loss_reduction": "mean",
  "sft_weight": 1.0
},



  "training": {
    "amp_dtype": "float16",
    "checkpoint_dir": "/checkpoints/tiger/instruments/dpo/seed_42",
    "early_stopping_mode": "best",
    "early_stopping_patience": 10,
    "gradient_accumulation_steps": 1,
    "log_every_steps": 200,
    "max_epochs": 500,
    "max_eval_batches": null,
    "max_grad_norm": 2.0,
    "max_steps": null,
    "max_train_batches": null,
    "min_delta": 0.0,
    "monitor": "val/sft/ndcg@1",
    "monitor_mode": "max",
    "prefix_method_metrics_with_stage": true,
    "progress_bar": true,
    "run_validation_at_start": false,
    "save_best": true,
    "save_every_epochs": null,
    "save_last": true,
    "scheduler_step_on": "none",
    "skip_non_finite_loss": false,
    "use_amp": true,
    "val_sample_fraction": null,
    "val_sample_resample": true,
    "val_sample_seed": 0,
    "validate_every_epochs": 1,
    "validate_every_steps": null
  },

  "optimizer": {
    "lr": 0.00003,
    "weight_decay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 1e-8
  },

  "scheduler": null
}
