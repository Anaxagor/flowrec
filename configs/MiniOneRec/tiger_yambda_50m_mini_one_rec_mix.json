{
  "experiment_name": "tiger_yambda_50m_mini_one_rec_mix",
  "seed": 42,
  "data": {
    "source": "yambda",
    "interactions_path": "data/raw/dataframe_format/yambda_50m/listens.parquet",
    "semantic_id_path": "datasets/semantic_ids/exp2-tuned-params/yambda_50m_listens/semantic_ids.json",
    "embeddings_path": null,
    "use_hf": false
  },
  "dataset": {
    "num_codebooks": 4,
    "dataset_type": "flat",
    "dataset_size": "50m",
    "event_file": "listens",
    "streaming": false,
    "hf_recent_months": 2,
    "positive_criterion": null,
    "allowed_event_types": null,
    "min_played_ratio_pct": 50.0,
    "organic_filter": "any",
    "split_strategy": "leave_one_out",
    "min_history_len": 1,
    "deduplicate_consecutive": true,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "max_history_len": 50,
    "history_padding": "left",
    "train_example_layout": "prefix_target",
    "train_target_policy": "last_n",
    "train_last_n": 128,
    "train_all_prefixes": false,
    "filter_cold_items_after_split": true,
    "cold_item_train_source": "observed",
    "offset_semantic_ids_by_one": false,
    "drop_items_missing_semantic_id": true,
    "drop_items_missing_embedding": false
  },
  "dataloader": {
    "train_batch_size": 256,
    "validation_batch_size": 64,
    "num_workers": 8,
    "persistent_workers": true,
    "pin_memory": true,
    "train_drop_last": false
  },
  "model": {
    "embedding_dim": 192,
    "codebook_size": 256,
    "num_positions": 50,
    "use_user_token": false,
    "user_ids_count": 0,
    "num_heads": 2,
    "num_encoder_layers": 2,
    "num_decoder_layers": 2,
    "dim_feedforward": 512,
    "d_kv": 32,
    "dropout": 0.2,
    "activation": "relu",
    "num_beams": 20,
    "top_k": 20,
    "layer_norm_eps": 1e-06,
    "initializer_range": 0.02,
    "checkpoint_path": "checkpoints/exp2-tuned_params/initial/tiger/yambda_50m/checkpoints/best.pt"
  },
  "method": {
    "name": "mini-one-rec",
    "reward_type": "mix",
    "reward_model": "mix",
    "rollout_strategy": "sample",
    "num_rollouts": 8,
    "rollout_temperature": 1.0,
    "rollout_top_k": 100,
    "rollout_top_p": 0.98,
    "force_ground_truth_in_group": true,
    "rank_reward_weight": 0.05,
    "normalize_rank_reward": true,
    "clip_epsilon": 0.1,
    "beta": 0.003,
    "rollout_constrain_valid_sequences": true,
    "rollout_exclude_seen_items": false,
    "sft_weight": 1.0,
    "reward": {
      "normalize": "none",
      "components": [
        {
          "name": "sasrec",
          "weight": 0.7,
          "reward": {
            "transform": "sigmoid",
            "temperature": 1.0
          }
        },
        {
          "name": "similarity",
          "weight": 0.3,
          "reward": {
            "mode": "exact"
          }
        }
      ]
    },
    "reward_power": 1.0,
    "sasrec": {
      "checkpoint_path": "checkpoints/exp2-tuned_params/initial/sasrec/yambda_50m_listens/seed_42/best.pt"
    }
  },
  "training": {
    "checkpoint_dir": "checkpoints/mini_one_rec/yambda_50m/mix",
    "max_epochs": 20,
    "max_steps": null,
    "validate_every_epochs": 5,
    "validate_every_steps": null,
    "gradient_accumulation_steps": 8,
    "max_grad_norm": 0.5,
    "use_amp": true,
    "amp_dtype": "float16",
    "log_every_steps": 500,
    "progress_bar": false,
    "run_validation_at_start": false,
    "save_best": true,
    "save_last": true,
    "save_every_epochs": null,
    "monitor": "val/sft/ndcg@5",
    "monitor_mode": "max",
    "early_stopping_patience": 5,
    "early_stopping_mode": "best",
    "min_delta": 0,
    "scheduler_step_on": "none",
    "evaluate_generation": true,
    "generation_constrain_valid_sequences": true,
    "generation_num_beams": 5,
    "generation_num_return_sequences": 5,
    "generation_topk": [
      5
    ],
    "test_evaluate_generation": true,
    "test_generation_num_beams": 20,
    "test_generation_num_return_sequences": 20,
    "test_generation_topk": [
      5,
      10,
      20
    ]
  },
  "optimizer": {
    "lr": 1e-05,
    "weight_decay": 0.01,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08
  },
  "scheduler": null,
  "comet": {
    "enabled": false
  }
}
