{
  "experiment_name": "exp2_tiger_instruments_sft",
  "seed": 42,
  "data": {
    "source": "amazon",
    "reviews_path": "data/raw/dataframe_format/reviews_instruments_2018.parquet",
    "metadata_path": "data/raw/dataframe_format/meta_instruments_2018.parquet",
    "semantic_id_path": "datasets/semantic_ids/exp2-tuned-params/instruments/semantic_ids.json",
    "processed_cache_dir": "artifacts/data_cache/exp2-tuned-params/tiger_instruments",
    "rebuild_processed_cache": false
  },
  "dataset": {
    "num_codebooks": 4,
    "max_sequence_length": 20,
    "max_history_len": 20,
    "item_key": "asin",
    "metadata_item_key": "asin",
    "filter_reviews_to_metadata": true,
    "positive_criterion": "verified_purchase == True",
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "use_verified_only": false,
    "keep_raw_reviews": false,
    "split_strategy": "leave_one_out",
    "min_history_len": 1,
    "train_example_layout": "prefix_target",
    "train_window_len": null,
    "train_window_stride": null,
    "train_all_prefixes": true,
    "train_target_policy": "all",
    "train_targets_per_user": 256,
    "train_stride": 10,
    "train_last_n": 512,
    "train_hybrid_recent_n": 256,
    "train_hybrid_random_n": 256,
    "deduplicate_consecutive": false,
    "global_val_timestamp": null,
    "global_test_timestamp": null,
    "global_val_ratio": 0.1,
    "global_test_ratio": 0.1,
    "global_history_policy": "rolling",
    "global_eval_target_mode": "all",
    "history_padding": "left",
    "filter_cold_items_after_split": false,
    "cold_item_train_source": "observed",
    "offset_semantic_ids_by_one": true,
    "drop_items_missing_semantic_id": true,
    "user_hash_mod": null
  },
  "dataloader": {
    "train_batch_size": 2048,
    "validation_batch_size": 1024,
    "test_batch_size": 64,
    "num_workers": 8,
    "pin_memory": true,
    "persistent_workers": true,
    "train_drop_last": false,
    "include_raw_in_batch": false
  },
  "model": {
    "codebook_size": 256,
    "embedding_dim": 128,
    "num_heads": 6,
    "num_encoder_layers": 2,
    "num_decoder_layers": 2,
    "dim_feedforward": 512,
    "d_kv": 32,
    "dropout": 0.1,
    "activation": "relu",
    "layer_norm_eps": 1e-6,
    "initializer_range": 0.02,
    "num_beams": 20,
    "top_k": 20,
    "use_user_token": false,
    "user_ids_count": 0,
    "enable_flow_head": true,
    "detach_flow_head_trunk": false
  },
  "method": {
    "name": "sft"
  },
  "training": {
    "max_epochs": 200,
    "max_steps": null,
    "gradient_accumulation_steps": 1,
    "max_grad_norm": 2.0,
    "skip_non_finite_loss": false,
    "use_amp": true,
    "amp_dtype": "float16",
    "scheduler_step_on": "none",
    "log_every_steps": 500,
    "progress_bar": false,
    "validate_every_epochs": 5,
    "validate_every_steps": null,
    "run_validation_at_start": false,
    "save_best": true,
    "save_last": true,
    "save_every_epochs": null,
    "monitor": "val/sft/ndcg@1",
    "monitor_mode": "max",
    "early_stopping_patience": 10,
    "early_stopping_mode": "best",
    "min_delta": 0.0,
    "prefix_method_metrics_with_stage": true,
    "max_train_batches": null,
    "max_eval_batches": null,
    "val_sample_fraction": null,
    "val_sample_seed": 0,
    "val_sample_resample": true,
    "gradient_checkpointing": false,
    "init_checkpoint_path": "checkpoints/exp2-tuned_params/initial/tiger/instruments/best.pt",
    "init_checkpoint_strict": true,
    "evaluate_generation": true,
    "generation_num_beams": 1,
    "generation_num_return_sequences": 1,
    "generation_topk": [1],
    "generation_constrain_valid_sequences": true,
    "generation_exclude_seen_items": false,
    "test_evaluate_generation": true,
    "test_generation_num_beams": 20,
    "test_generation_num_return_sequences": 20,
    "test_generation_topk": [5, 10, 20]
  },
  "optimizer": {
    "lr": 0.0018511868508356536,
    "weight_decay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 1e-8
  }
}
