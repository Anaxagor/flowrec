{
  "experiment_name": "tiger_beauty_dpo",
  "seed": 42,

  "data": {
    "reviews_path": "data/raw/reviews_Beauty_5.jsonl.gz",
    "metadata_path": "data/raw/meta_Beauty.jsonl.gz",
    "semantic_id_path": "artifacts/tokenizers/rqvae_beauty/semantic_ids.json"
  },

  "dataset": {
    "num_codebooks": 4,
    "max_sequence_length": 20,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "item_key": "asin",
    "split_strategy": "leave_one_out",
    "train_all_prefixes": true,
    "offset_semantic_ids_by_one": false
  },

  "dataloader": {
    "train_batch_size": 256,
    "validation_batch_size": 256,
    "num_workers": 8,
    "pin_memory": true,
    "train_drop_last": true,
    "prefetch_factor": 4
  },

  "model": {
    "embedding_dim": 128,
    "codebook_size": 256,
    "num_positions": 20,
    "user_ids_count": 2000,
    "num_heads": 6,
    "num_encoder_layers": 4,
    "num_decoder_layers": 4,
    "dim_feedforward": 1024,
    "d_kv": 64,
    "dropout": 0.1,
    "activation": "relu",
    "num_beams": 100,
    "top_k": 20,
    "layer_norm_eps": 1e-6,
    "initializer_range": 0.02
  },

  "method": {
    "name": "dpo",
    "beta": 0.1,
    "num_negatives": 1,
    "negative_sampler": "random",
    "reference_model_strategy": "frozen_init",
    "loss_reduction": "mean",
    "sft_weight": 0.0
  },

  "training": {
    "max_epochs": 10000,
    "max_steps": 200000,

    "validate_every_epochs": 5,
    "validate_every_steps": null,

    "gradient_accumulation_steps": 1,
    "max_grad_norm": null,

    "use_amp": true,
    "amp_dtype": "bfloat16",

    "log_every_steps": 50,
    "checkpoint_dir": "checkpoints/tiger_beauty_dpo",
    "save_best": true,
    "save_last": true,
    "monitor": "val/dpo/loss",
    "monitor_mode": "min",
    "early_stopping_patience": 5,
    "min_delta": 0.001,
    "evaluate_generation": true
  },

  "optimizer": {
    "lr": 0.0003,
    "weight_decay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 1e-8
  },

  "scheduler": null
}
