{
  "rqvae": {
    "input_dim": 384,
    "latent_dim": 32,
    "hidden_dims": [
      512,
      256,
      128
    ],
    "num_codebooks": 4,
    "codebook_size": 256,
    "commitment_weight": 0.25,
    "dropout": 0.0,
    "use_batch_norm": false
  },
  "train": {
    "epochs": 200,
    "batch_size": 1024,
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "optimizer": "adamw",
    "val_ratio": 0.05,
    "num_workers": 0,
    "drop_last": false,
    "seed": 43,
    "gradient_clip_norm": 1.0,
    "log_every": 50,
    "progress_bar": true,
    "device": "cuda",
    "codebook_init": "kmeans",
    "kmeans_init_iters": 20,
    "kmeans_init_on_cpu": true,
    "kmeans_init_tolerance": 1e-06,
    "dead_code_reset_interval": 1
  },
  "normalize": "none",
  "collision_policy": "random_append",
  "level_offset_tokens": false,
  "collision_token_offset": null,
  "collision_suffix_size": null,
  "collision_seed": 43,
  "encode_batch_size": 4096
}