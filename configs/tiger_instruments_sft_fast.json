{
  "experiment_name": "tiger_instruments_sft_fast",
  "seed": 42,
  "data": {
    "reviews_path": "data/raw/Musical_Instruments.json.gz",
    "metadata_path": "data/raw/meta_Musical_Instruments.json.gz",
    "semantic_id_path": "datasets/semantic_ids/instruments_level_offset/semantic_ids.json",
    "processed_cache_dir": "artifacts/data_cache/amazon_instruments_sft"
  },
  "dataset": {
    "num_codebooks": 4,
    "max_sequence_length": 20,
    "max_history_len": 20,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "item_key": "asin",
    "split_strategy": "leave_one_out",
    "train_all_prefixes": true,
    "train_target_policy": "all",
    "history_padding": "left",
    "offset_semantic_ids_by_one": true,
    "drop_items_missing_semantic_id": true,
    "filter_cold_items_after_split": false,
    "user_hash_mod": null
  },
  "dataloader": {
    "train_batch_size": 2048,
    "validation_batch_size": 1024,
    "test_batch_size": 64,
    "num_workers": 8,
    "persistent_workers": true,
    "pin_memory": true,
    "train_drop_last": false
  },
  "model": {
    "embedding_dim": 128,
    "codebook_size": 256,
    "user_ids_count": 0,
    "use_user_token": false,
    "num_heads": 6,
    "d_kv": 32,
    "num_encoder_layers": 2,
    "num_decoder_layers": 2,
    "dim_feedforward": 512,
    "dropout": 0.1,
    "activation": "relu",
    "num_beams": 20,
    "top_k": 20
  },
  "method": {"name": "sft"},
  "training": {
    "max_epochs": 200,
    "validate_every_epochs": 5,
    "gradient_accumulation_steps": 1,
    "max_grad_norm": 0.5,
    "use_amp": true,
    "amp_dtype": "float16",
    "monitor": "val/sft/ndcg@1",
    "monitor_mode": "max",
    "early_stopping_mode": "best",
    "early_stopping_patience": 10,
    "save_best": true,
    "save_last": true,
    "evaluate_generation": true,
    "generation_num_beams": 1,
    "generation_num_return_sequences": 1,
    "generation_topk": [1],
    "generation_constrain_valid_sequences": true,
    "test_generation_num_beams": 20,
    "test_generation_num_return_sequences": 20,
    "test_generation_topk": [5, 10, 20]
  },
  "optimizer": {
    "lr": 0.002,
    "weight_decay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 1e-8
  }
}
