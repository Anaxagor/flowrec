{
  "experiment_name": "tiger_yambda_50m_listens_sft_tuned",
  "seed": 42,
  "comet": {
    "enabled": false
  },
  "data": {
    "source": "yambda",
    "interactions_path": "data/raw/yambda/flat/50m/multi_event.parquet",
    "semantic_id_path": "datasets/semantic_ids/exp2-tuned-params/yambda_50m_listens/semantic_ids.json",
    "embeddings_path": null
  },
  "dataset": {
    "num_codebooks": 4,
    "dataset_type": "flat",
    "dataset_size": "50m",
    "event_file": "multi_event",
    "streaming": false,
    "hf_recent_months": 2,
    "positive_criterion": null,
    "allowed_event_types": ["listen"],
    "min_played_ratio_pct": 50.0,
    "organic_filter": "any",
    "split_strategy": "leave_one_out",
    "min_history_len": 1,
    "deduplicate_consecutive": true,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "max_history_len": 50,
    "history_padding": "left",
    "train_example_layout": "prefix_target",
    "train_target_policy": "last_n",
    "train_last_n": 128,
    "train_all_prefixes": false,
    "filter_cold_items_after_split": true,
    "cold_item_train_source": "observed",
    "offset_semantic_ids_by_one": false,
    "drop_items_missing_semantic_id": true,
    "drop_items_missing_embedding": false
  },
  "dataloader": {
    "train_batch_size": 2048,
    "validation_batch_size": 256,
    "num_workers": 8,
    "persistent_workers": true,
    "pin_memory": true,
    "train_drop_last": false
  },
  "model": {
    "embedding_dim": 192,
    "codebook_size": 256,
    "use_user_token": false,
    "user_ids_count": 0,
    "num_heads": 2,
    "num_encoder_layers": 2,
    "num_decoder_layers": 2,
    "dim_feedforward": 512,
    "d_kv": 32,
    "dropout": 0.2,
    "activation": "relu",
    "num_beams": 5,
    "top_k": 5,
    "layer_norm_eps": 0.000001,
    "initializer_range": 0.02
  },
  "method": {
    "name": "sft"
  },
  "training": {
    "max_epochs": 200,
    "max_steps": null,
    "validate_every_epochs": 1,
    "validate_every_steps": null,
    "gradient_accumulation_steps": 1,
    "max_grad_norm": 1.0,
    "use_amp": true,
    "amp_dtype": "bfloat16",
    "log_every_steps": 50,
    "progress_bar": false,
    "run_validation_at_start": false,
    "save_best": true,
    "save_last": true,
    "save_every_epochs": null,
    "monitor": "val/sft/ndcg@5",
    "monitor_mode": "max",
    "early_stopping_patience": 10,
    "early_stopping_mode": "best",
    "min_delta": 0,
    "scheduler_step_on": "none",
    "evaluate_generation": true,
    "generation_constrain_valid_sequences": true,
    "generation_num_beams": 5,
    "generation_num_return_sequences": 5,
    "generation_topk": [5],
    "test_evaluate_generation": true,
    "test_generation_num_beams": 20,
    "test_generation_num_return_sequences": 20,
    "test_generation_topk": [5, 10, 20]
  },
  "optimizer": {
    "lr": 0.0003,
    "weight_decay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 0.00000001
  },
  "scheduler": null
}
