{
  "experiment_name": "tiger_yambda_50m_sdpo",
  "seed": 42,
  "data": {
    "source": "yambda",
    "interactions_path": "data/raw/dataframe_format/yambda_50m/listens.parquet",
    "semantic_id_path": "datasets/semantic_ids/exp2-tuned-params/yambda_50m_listens/semantic_ids.json",
    "embeddings_path": null,
    "use_hf": false
  },
"dataset": {
  "dataset": "yambda",
  "dataset_size": "50m",
  "dataset_type": "flat",
  "event_file": "multi_event",

  "hf_start_date": null,
  "hf_end_date": null,
  "hf_recent_months": 2,

  "global_val_cutoff": null,
  "global_test_cutoff": null,

  "positive_criterion": "event_type == 'listen' and played_ratio_pct >= 50",

  "split_strategy": "leave_one_out",
  "train_example_layout": "dense_causal",

  "post_filter_cold_items": true,
  "cold_item_reference": "observed"
},
  "dataloader": {
    "train_batch_size": 2048,
    "validation_batch_size": 64,
    "num_workers": 8,
    "persistent_workers": true,
    "pin_memory": true,
    "train_drop_last": false
  },
  "model": {
    "embedding_dim": 192,
    "codebook_size": 256,
    "num_positions": 50,
    "use_user_token": false,
    "user_ids_count": 0,
    "num_heads": 2,
    "num_encoder_layers": 2,
    "num_decoder_layers": 2,
    "dim_feedforward": 512,
    "d_kv": 32,
    "dropout": 0.2,
    "activation": "relu",
    "num_beams": 20,
    "top_k": 20,
    "layer_norm_eps": 1e-06,
    "initializer_range": 0.02,
    "checkpoint_path": "checkpoints/exp2-tuned_params/initial/tiger/yambda_50m/checkpoints/best.pt"
  },
  "method": {
    "name": "sdpo",
    "beta": 0.1,
    "num_negatives": 3,
    "negative_sampler": "curriculum",
    "curriculum_steps": 3000,
    "sampling_temperature": 1.0,
    "exclude_history_in_sampling": true,
    "sasrec": {
      "checkpoint_path": "checkpoints/exp2-tuned_params/initial/sasrec/yambda_50m_listens/seed_42/best.pt"
    },
    "reference_model_strategy": "frozen_init",
    "loss_reduction": "mean",
    "calibrate_sft_weight": true
  },
  "training": {
    "checkpoint_dir": "checkpoints/tiger/yambda_50m/sdpo",
    "max_epochs": 20,
    "max_steps": null,
    "validate_every_epochs": 5,
    "validate_every_steps": null,
    "gradient_accumulation_steps": 1,
    "max_grad_norm": 0.5,
    "use_amp": true,
    "amp_dtype": "float16",
    "log_every_steps": 500,
    "progress_bar": false,
    "run_validation_at_start": false,
    "save_best": true,
    "save_last": true,
    "save_every_epochs": null,
    "monitor": "val/sft/ndcg@10",
    "monitor_mode": "max",
    "early_stopping_patience": 10,
    "early_stopping_mode": "best",
    "min_delta": 0,
    "scheduler_step_on": "none",
    "evaluate_generation": true,
    "generation_constrain_valid_sequences": true,
    "generation_num_beams": 10,
    "generation_num_return_sequences": 10,
    "generation_topk": [
      10
    ],
    "test_evaluate_generation": true,
    "test_generation_num_beams": 20,
    "test_generation_num_return_sequences": 20,
    "test_generation_topk": [
      5,
      10,
      20
    ]
  },
  "optimizer": {
    "lr": 3e-05,
    "weight_decay": 0.01,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08
  },
  "scheduler": null,
  "comet": {
    "enabled": false
  }
}
