{
  "experiment_name": "tiger_beauty_global_time_sft",
  "seed": 42,
  "data": {
    "reviews_path": "data/raw/dataframe_format/reviews_beauty_2014.parquet",
    "metadata_path": "data/raw/dataframe_format/meta_beauty_2014.parquet",
    "semantic_id_path": "artifacts/tokenizers/rqvae_beauty/semantic_ids.json"
  },
  "dataset": {
    "num_codebooks": 4,
    "max_sequence_length": 20,
    "max_history_len": 20,
    "min_user_interactions": 1,
    "min_item_interactions": 1,
    "item_key": "asin",
    "split_strategy": "global_time",
    "global_val_ratio": 0.1,
    "global_test_ratio": 0.1,
    "global_history_policy": "rolling",
    "global_eval_target_mode": "last_per_user",
    "train_all_prefixes": false,
    "offset_semantic_ids_by_one": false
  },
  "dataloader": {
    "batch_size": 256,
    "train_batch_size": 256,
    "validation_batch_size": 256,
    "num_workers": 8,
    "pin_memory": true,
    "train_drop_last": true,
    "prefetch_factor": 4
  },
  "model": {
    "embedding_dim": 128,
    "codebook_size": 256,
    "num_positions": 20,
    "user_ids_count": 2000,
    "num_heads": 6,
    "num_encoder_layers": 4,
    "num_decoder_layers": 4,
    "dim_feedforward": 1024,
    "d_kv": 64,
    "dropout": 0.1,
    "activation": "relu",
    "num_beams": 100,
    "top_k": 20,
    "layer_norm_eps": 1e-06,
    "initializer_range": 0.02
  },
  "method": {
    "name": "sft"
  },
  "training": {
    "max_epochs": 10000,
    "max_steps": 200000,
    "validate_every_epochs": 1,
    "validate_every_steps": null,
    "gradient_accumulation_steps": 1,
    "max_grad_norm": null,
    "use_amp": false,
    "amp_dtype": "bfloat16",
    "log_every_steps": 50,
    "checkpoint_dir": "checkpoints/tiger_beauty_global_time_sft",
    "save_best": true,
    "save_last": true,
    "monitor": "val/sft/ndcg@5",
    "monitor_mode": "max",
    "early_stopping_patience": 5,
    "min_delta": 0.0,
    "evaluate_generation": true,
    "generation_num_beams": 5,
    "generation_topk": [
      5
    ],
    "generation_num_return_sequences": 5,
    "run_validation_at_start": true
  },
  "optimizer": {
    "lr": 0.0003,
    "weight_decay": 0.01,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08
  },
  "scheduler": null
}
