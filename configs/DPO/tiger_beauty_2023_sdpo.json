{
  "experiment_name": "tiger_beauty_2023_sdpo",
  "experiments_dir": "experiments/tiger/beauty_2023/sdpo",
  "seed": 42,
  "data": {
    "reviews_path": "data/raw/dataframe_format/reviews_beauty_2023.parquet",
    "metadata_path": "data/raw/dataframe_format/meta_beauty_2023.parquet",
    "semantic_id_path": "datasets/semantic_ids/exp2-tuned-params/beauty_2023/semantic_ids.json"
  },
  "dataset": {
    "num_codebooks": 4,
    "max_sequence_length": 20,
    "max_history_len": 20,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "item_key": "parent_asin",
    "metadata_item_key": "parent_asin",
    "split_strategy": "leave_one_out",
    "train_all_prefixes": true,
    "train_target_policy": "all",
    "history_padding": "left",
    "filter_cold_items_after_split": false,
    "offset_semantic_ids_by_one": true,
    "drop_items_missing_semantic_id": true,
    "positive_criterion": "verified_purchase == True",
    "train_example_layout": "prefix_target",
    "train_last_n": 512,
    "min_history_len": 1,
    "cold_item_train_source": "observed",
    "deduplicate_consecutive": false,
    "use_verified_only": false
  },
  "dataloader": {
    "train_batch_size": 2048,
    "validation_batch_size": 64,
    "num_workers": 8,
    "persistent_workers": true,
    "pin_memory": true,
    "train_drop_last": false
  },
  "model": {
    "embedding_dim": 128,
    "codebook_size": 256,
    "num_positions": 20,
    "use_user_token": false,
    "user_ids_count": 0,
    "num_heads": 6,
    "num_encoder_layers": 2,
    "num_decoder_layers": 2,
    "dim_feedforward": 512,
    "d_kv": 32,
    "dropout": 0.1,
    "activation": "relu",
    "num_beams": 20,
    "top_k": 20,
    "layer_norm_eps": 1e-06,
    "initializer_range": 0.02,
    "checkpoint_path": "checkpoints/exp2-tuned_params/initial/tiger/beauty_2023/best.pt"
  },
  "method": {
    "name": "sdpo",
    "beta": 0.1,
    "num_negatives": 3,
    "negative_sampler": "curriculum",
    "curriculum_steps": 3000,
    "sampling_temperature": 1.0,
    "exclude_history_in_sampling": true,
    "sasrec": {
      "checkpoint_path": "checkpoints/exp2-tuned_params/initial/sasrec/beauty_2023/best.pt"
    },
    "reference_model_strategy": "frozen_init",
    "loss_reduction": "mean",
    "calibrate_sft_weight": false,
    "calibration_num_batches": 8,
    "calibration_target_ratio": 1.0,
    "sft_weight": 0.10501896531433569
  },
  "training": {
    "checkpoint_dir": "/checkpoints/tiger/beauty_2023/sdpo",
    "max_epochs": 20,
    "max_steps": null,
    "validate_every_epochs": 10,
    "validate_every_steps": null,
    "gradient_accumulation_steps": 1,
    "max_grad_norm": 0.5,
    "use_amp": true,
    "amp_dtype": "float16",
    "log_every_steps": 500,
    "progress_bar": false,
    "run_validation_at_start": false,
    "save_best": true,
    "save_last": true,
    "save_every_epochs": null,
    "monitor": "val/sft/ndcg@10",
    "monitor_mode": "max",
    "early_stopping_patience": 10,
    "early_stopping_mode": "best",
    "min_delta": 0,
    "scheduler_step_on": "none",
    "evaluate_generation": true,
    "generation_constrain_valid_sequences": true,
    "generation_num_beams": 10,
    "generation_num_return_sequences": 10,
    "generation_topk": [
      10
    ],
    "test_evaluate_generation": true,
    "test_generation_num_beams": 20,
    "test_generation_num_return_sequences": 20,
    "test_generation_topk": [
      5,
      10,
      20
    ],
    "val_sample_fraction": null,
    "val_sample_seed": 0,
    "val_sample_resample": true
  },
  "optimizer": {
    "lr": 3e-05,
    "weight_decay": 0.01,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08
  },
  "scheduler": null
}
